{
  "name": "@system-automation/design-system",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "Design System da T&T com componentes, tokens visuais, padrões de interface e documentação em Storybook.",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run && pnpm test:a11y-runner",
    "test:a11y-runner": "node --test scripts/a11y-audit.test.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint --max-warnings 0",
    "lint:fix": "eslint --fix",
    "lint:dev": "eslint --max-warnings 200",
    "a11y:audit": "pnpm build-storybook && node scripts/a11y-audit.mjs",
    "a11y:audit:static": "node scripts/a11y-audit.mjs",
    "chunk-budget": "node scripts/chunk-budget.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build-storybook && pnpm chunk-budget"
  },
  "exports": {
    ".": "./index.ts",
    "./components": "./components.ts",
    "./components/providers": "./components/providers/index.ts",
    "./components/ui": "./components/ui/index.ts",
    "./hooks": "./hooks/index.ts",
    "./lib": "./lib/index.ts",
    "./lib/*": "./lib/*",
    "./hooks/*": "./hooks/*",
    "./components/form": "./components/form/index.ts",
    "./components/page-shell": "./components/layout/page-shell/index.ts",
    "./components/page-header": "./components/layout/page-header/index.ts",
    "./components/page-loader": "./components/layout/page-loader/index.ts",
    "./components/page-tabs": "./components/layout/page-tabs/index.ts",
    "./components/theme-toggle": "./components/layout/theme-toggle/index.ts",
    "./components/error-card": "./components/feedback/error-card/index.ts",
    "./components/empty-state": "./components/feedback/empty-state/index.ts",
    "./components/back-button": "./components/navigation/back-button/index.ts",
    "./components/skip-link": "./components/navigation/skip-link/index.ts",
    "./components/confirm-code-screen": "./components/content/confirm-code-screen/index.ts",
    "./components/markdown": "./components/content/markdown/index.ts",
    "./components/emoji-picker": "./components/content/emoji-picker/index.ts",
    "./components/select-with-search": "./components/content/select-with-search/index.ts",
    "./components/logo-with-title": "./components/content/logo-with-title/index.ts",
    "./components/table": "./components/data-display/table/index.ts",
    "./components/horizontal-bar-chart": "./components/data-display/horizontal-bar-chart/index.ts",
    "./components/metric-card": "./components/data-display/metric-card/index.ts",
    "./components/radial-chart": "./components/data-display/radial-chart/index.ts",
    "./components/typography": "./components/data-display/typography/index.ts",
    "./components/data-display/*": "./components/data-display/*",
    "./components/layout/*": "./components/layout/*",
    "./components/feedback/feature-boundary": "./components/feedback/feature-boundary/index.ts",
    "./components/security-verification-dialog": "./components/feedback/security-verification-dialog/index.ts",
    "./components/feedback/*": "./components/feedback/*",
    "./components/content/*": "./components/content/*",
    "./components/*": "./components/*",
    "./globals.css": "./globals.css"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.0.0"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/react": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "emoji-picker-react": "^4.18.0",
    "framer-motion": "^12.23.24",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.546.0",
    "react-markdown": "^9.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tiptap-markdown": "^0.9.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.3",
    "@eslint/js": "^9.38.0",
    "@hookform/resolvers": "^5.2.2",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-themes": "^10.3.6",
    "@storybook/nextjs-vite": "^10.3.6",
    "@storybook/react": "^10.3.6",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.38.0",
    "eslint-plugin-better-tailwindcss": "^4.5.0",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "next": "^16.2.3",
    "postcss": "^8.5.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.0.0",
    "storybook": "^10.3.6",
    "tailwindcss": "^4.1.16",
    "typescript": "^5",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5",
    "zod": "^4.1.12"
  }
}
