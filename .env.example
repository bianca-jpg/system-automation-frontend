NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000
AUTH_URL=http://localhost:3000
AUTH_SECRET=dev-only-atacado-or-auth-secret

# Login via Microsoft Entra ID (SSO). Application (client) ID e Directory
# (tenant) ID vêm da tela "Overview" do app registrado no Entra ID; o Client
# Secret vem de "Certificates & secrets" (só aparece uma vez, na criação).
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/SEU_TENANT_ID/v2.0
